{
  "schemaVersion": 1,
  "id": "autodig",
  "version": "${version}",
  "name": "AutoDig",
  "description": "Клиентский мод: сам вскапывает область между двумя отмеченными точками. На сервер ставить не нужно.",
  "authors": ["kabanin"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.autodig.client.AutoDigClient"]
  },
  "mixins": ["autodig.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.19.4",
    "java": ">=17",
    "fabric-api": "*"
  }
}
